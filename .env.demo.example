# Environment for the public demo stack (docker-compose.demo.yml).
# Copy to .env.demo and replace every value. Do NOT commit the filled-in .env.demo.
#
#   cp .env.demo.example .env.demo
#   # edit .env.demo, then:
#   docker compose --env-file .env.demo -f docker-compose.demo.yml up -d --build

# --- Your public domain (an A record must point it at this server's IP) ---
DOMAIN=breachsim.example.com

# --- Secrets: generate fresh values, never reuse the examples ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (Must be a NEW key — the one from this repo's git history is blocked.)
ENCRYPTION_KEY=
# Long random strings, URL-safe characters only (they go inside connection URLs).
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- AI scenario generation ---
# rule_based = free deterministic generator (no key needed).
# together   = real LLM scenarios; create a key at https://api.together.ai and paste below,
#              and enable Zero Data Retention in the Together console (Settings -> Privacy).
AI_PROVIDER=rule_based
TOGETHER_API_KEY=
TOGETHER_MODEL=openai/gpt-oss-120b

# --- Demo content & login screen ---
# true also seeds a sample employee directory so you can launch a campaign right away.
SEED_DEMO_CONTENT=true
# true shows the seeded demo credentials on the login page. Leave false on a public URL.
NEXT_PUBLIC_DEMO_MODE=false

# --- Optional ---
# true re-enables the interactive API docs at /docs (off by default).
API_DOCS_ENABLED=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Real outbound email/SMS via the lab adapters is off by default. Real enterprise delivery
# (Microsoft 365 / Google Workspace) is configured inside the app per tenant, not here.
LAB_EMAIL_PROVIDER_ENABLED=false
