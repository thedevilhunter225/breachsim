# Reference application settings for Azure Container Apps. Terraform wires managed
# resources and Key Vault references; do not commit populated secrets or tfvars.
# Copied to .env.production, this is also the variable file for docker-compose.production.yml
# (CI runs `docker compose config` against it). Every value is an obviously fake example;
# the production startup check rejects the SECRET_KEY and ENCRYPTION_KEY placeholders.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://user:password@private-postgres:5432/breachsim?sslmode=require
REDIS_URL=rediss://:password@private-managed-redis:10000/0
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-generated-fernet-key

FRONTEND_BASE_URL=https://app.training.example.com
PUBLIC_URL_SCHEME=https
PLATFORM_TRAINING_DOMAIN=training.example.com
FRONT_DOOR_ID=00000000-0000-0000-0000-000000000000
FRONT_DOOR_ENDPOINT_HOSTNAME=breachsim-example.z01.azurefd.net
CORS_ORIGINS=["https://app.training.example.com"]
TRUSTED_HOSTS=["private-api-origin.azurecontainerapps.io"]
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=.training.example.com
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_DOCS_ENABLED=false
SEED_DEMO_CONTENT=false

EMAIL_DELIVERY_BACKEND=service_bus
SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=sb-breachsim-example.servicebus.windows.net
SERVICE_BUS_CAMPAIGN_QUEUE=campaign-delivery
AZURE_KEY_VAULT_URL=https://kv-breachsim-example.vault.azure.net/
EVIDENCE_STORAGE_ACCOUNT_URL=https://stbreachsimexample.blob.core.windows.net/
EVIDENCE_STORAGE_CONTAINER=audit-evidence

MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET_REF=kv://microsoft-graph-client-secret
MICROSOFT_GRAPH_REDIRECT_URI=https://app.training.example.com/api/v1/email-connections/microsoft/callback
GOOGLE_SERVICE_ACCOUNT_SECRET_REF=kv://google-service-account
SSO_CALLBACK_URL=https://app.training.example.com/api/v1/auth/sso/callback

AI_PROVIDER=together
TOGETHER_API_KEY=
TOGETHER_MODEL=openai/gpt-oss-120b
TOGETHER_TIMEOUT_SECONDS=45
TOGETHER_MAX_RETRIES=2

MAX_CAMPAIGN_RECIPIENTS=50000
CAMPAIGN_TOKEN_TTL_DAYS=30
LAB_EMAIL_PROVIDER_ENABLED=false
LAB_SMS_PROVIDER_ENABLED=false
# Synthetic voice/video cloning is excluded from the initial production launch: production
# refuses any clone provider other than none until this approval is set to true.
SYNTHETIC_MEDIA_PRODUCTION_APPROVED=false
VOICE_CLONE_PROVIDER=none
VIDEO_CLONE_PROVIDER=none

# Required only while running scripts/bootstrap_production.py. Generate TOTP
# secrets with: python -c "import pyotp; print(pyotp.random_base32())"
BOOTSTRAP_ORG_NAME=Platform Operations
BOOTSTRAP_ORG_SLUG=platform-operations
BOOTSTRAP_ORG_TIMEZONE=UTC
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Platform Administrator
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_MFA_SECRET=
BOOTSTRAP_REVIEWER_EMAIL=
BOOTSTRAP_REVIEWER_NAME=Approval Reviewer
BOOTSTRAP_REVIEWER_PASSWORD=
BOOTSTRAP_REVIEWER_MFA_SECRET=

# Single-VM docker-compose.production.yml only. Container Apps get the database, Redis and
# hostnames from Terraform and authenticate with a managed identity instead. The passwords
# are embedded in connection URLs, so use URL-safe characters.
DOMAIN=app.training.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
# Service principal for DefaultAzureCredential (Service Bus, Key Vault, Blob storage).
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-with-the-service-principal-secret
