# Local development/demo only. Copy to .env and never commit the populated file.
BACKEND_DATABASE_URL=postgresql+psycopg://breachsim:breachsim@postgres:5432/breachsim
BACKEND_REDIS_URL=redis://redis:6379/0
BACKEND_SECRET_KEY=change-me-in-production
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKEND_ENCRYPTION_KEY=
BACKEND_FRONTEND_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_MODE=true

# Scenario generation. The key is backend-only; never use a NEXT_PUBLIC_* variable.
AI_PROVIDER=together
TOGETHER_API_KEY=
TOGETHER_MODEL=openai/gpt-oss-120b
TOGETHER_TIMEOUT_SECONDS=45
TOGETHER_MAX_RETRIES=2

# The first enterprise launch supports Email and QR. These remain disabled/sandbox-only.
VOICE_CLONE_PROVIDER=none
ELEVENLABS_API_KEY=
VIDEO_CLONE_PROVIDER=none
DID_API_KEY=
