BACKEND_DATABASE_URL=postgresql+psycopg://breachsim:breachsim@postgres:5432/breachsim
BACKEND_REDIS_URL=redis://redis:6379/0
BACKEND_SECRET_KEY=change-me-in-production
# Encrypts integration credentials, employee phone numbers and persona summaries at rest.
# Leave blank for local development and the key is derived from BACKEND_SECRET_KEY.
# Required in production — generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKEND_ENCRYPTION_KEY=
BACKEND_FRONTEND_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEMO_MODE=false

# --- Real synthetic-media cloning (optional) ---
# Leave the providers as "none" to run on the free in-browser speech fallback.
# Set a provider + key to generate real cloned voice/video for consented personas.
VOICE_CLONE_PROVIDER=none          # none | elevenlabs
ELEVENLABS_API_KEY=
VIDEO_CLONE_PROVIDER=none          # none | did
DID_API_KEY=
